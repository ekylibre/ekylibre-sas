---
// Tableau des connecteurs de Fourmy et de Lyvre : équivalent HTML de la scène 3D (US1, accessibilité).
// docs/design/04-accueil-kit-connecteurs.md §4.3.
import Icon from '~/components/Icon.astro';
import { connectors as allConnectors, CATEGORY_META, CONNECTOR_STATUS_LABEL } from '~/lib/interop';
import type { Locale } from '~/i18n/routes';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const connectors = await allConnectors(lang);
const FLOW = {
  in: fr ? 'Vers le logiciel' : 'Into the software',
  out: fr ? 'Depuis le logiciel' : 'From the software',
  both: fr ? 'Dans les deux sens' : 'Both ways',
};
const head = fr
  ? ['Intégration', 'Fonction', 'Logiciel', 'Partenaire', 'Sens des données', 'État', 'Code']
  : ['Integration', 'What it does', 'Software', 'Partner', 'Data flow', 'Status', 'Code'];
---

<div class="overflow-x-auto rounded-2xl bg-white/70 shadow-[var(--shadow-card)] ring-1 ring-soil-800/8">
  <table class="w-full min-w-[60rem] text-left text-sm">
    <caption class="sr-only">{fr ? 'Intégrations de Fourmy et de Lyvre' : 'Fourmy and Lyvre integrations'}</caption>
    <thead class="bg-straw-100 font-display text-xs tracking-wide text-soil-800 uppercase">
      <tr>
        {head.map((h) => (
          <th scope="col" class="px-4 py-3 font-semibold">
            {h}
          </th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-soil-800/8">
      {connectors.map((c) => (
        <tr class="align-top" data-product={c.product} data-status={c.status}>
          <th scope="row" class="px-4 py-4">
            <span class="flex items-center gap-3 font-display font-semibold">
              <span class="medallion size-9 shrink-0 text-base" title={CATEGORY_META[c.category].label[lang]}>
                <Icon name={CATEGORY_META[c.category].icon} label={CATEGORY_META[c.category].label[lang]} />
              </span>
              {c.title}
            </span>
          </th>
          <td class="max-w-md px-4 py-4 text-muted">{c.summary}</td>
          <td class="px-4 py-4 font-display font-semibold whitespace-nowrap">{c.productName}</td>
          <td class="px-4 py-4">
            {c.partner ? (
              c.partner.url ? (
                <a href={c.partner.url} rel="noopener" target="_blank">
                  {c.partner.name}
                </a>
              ) : (
                c.partner.name
              )
            ) : (
              <span class="text-muted">—</span>
            )}
          </td>
          <td class="px-4 py-4 whitespace-nowrap">{FLOW[c.dataFlow]}</td>
          <td class="px-4 py-4 whitespace-nowrap">
            <span
              class:list={[
                'rounded-full px-2.5 py-1 font-mono text-xs',
                c.status === 'stable' ? 'bg-eky-green-deep/10 text-eky-green-text' : 'bg-wheat-400/20 text-soil-800',
              ]}
            >
              {CONNECTOR_STATUS_LABEL[c.status][lang]}
            </span>
          </td>
          <td class="px-4 py-4">
            {c.hasCode ? (
              <a href={c.codeUrl} rel="noopener" target="_blank" class="font-mono text-xs whitespace-nowrap">
                {c.codeUrl.replace('https://github.com/ekylibre/', '').replace('/tree/main/', '/')}
              </a>
            ) : (
              <span class="text-muted">—</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
