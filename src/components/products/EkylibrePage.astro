---
// Page produit Ekylibre (D3). Textes : docs/contenus/fr/ekylibre.md, points [À CONFIRMER] écartés
// (hébergement, Clic&Farm) ; chiffres du dépôt calculés au build (stats.core, stablePlugins).
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import ProductCta from './ProductCta.astro';
import { softwareJsonLd } from './jsonld';
import illusBureau from '~/assets/illustrations/bureau.webp';
import illusPlan from '~/assets/illustrations/plan-exploitation.webp';
import illusRegistres from '~/assets/illustrations/tracabilite-registres.webp';
import { routePath, type Locale } from '~/i18n/routes';
import { stats, formatInt } from '~/lib/data';
import { stableConnectors, CATEGORY_META } from '~/lib/interop';
import { LINKS } from '~/lib/links';
import { getProduct } from '~/lib/products';
import ProductLogo from './ProductLogo.astro';
import ProductHero from './ProductHero.astro';
import type { IconName } from '~/lib/icon-names';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const firstCommit = new Date(stats.core.firstCommit);
const firstMonth = firstCommit.toLocaleDateString(fr ? 'fr-FR' : 'en-GB', { month: 'long', year: 'numeric' });
const commits = formatInt(stats.core.commits, lang);
const contributors = formatInt(stats.core.contributors, lang);
const connectors = await stableConnectors(lang);

const title = fr ? 'Ekylibre, logiciel libre de gestion agricole' : 'Ekylibre, free farm management software';
const description = fr
  ? 'Matériels, stocks, suivi GPS, capteurs, agronomie, élevage et vigne : Ekylibre gère l’exploitation dans un logiciel libre, connecté et réversible. La comptabilité est tenue par Lyvre.'
  : 'Machinery, stock, GPS tracking, sensors, agronomy, livestock and vineyard: Ekylibre runs the farm in free software that is connected and reversible. The books are kept in Lyvre.';
const lyvre = getProduct('lyvre', lang);

const features: Array<{ icon: IconName; title: string; text: string }> = fr
  ? [
      {
        icon: 'land-parcels',
        title: 'Parcelles et agronomie',
        text: 'Parcellaire cartographié, assolement, interventions, fertilisation et traçabilité des intrants.',
      },
      {
        icon: 'cow',
        title: 'Élevage',
        text: 'Animaux, groupes, événements sanitaires, échanges avec l’EDE grâce au connecteur EDNotif.',
      },
      {
        icon: 'grape',
        title: 'Vigne et chai',
        text: 'Avec l’extension Ekyviti, de la parcelle de vigne jusqu’à la bouteille.',
      },
      {
        icon: 'tractor',
        title: 'Matériels et suivi GPS',
        text: 'Parc de matériel, temps de travail, entretien ; traces GPS des boîtiers de tracteurs reprises en interventions.',
      },
      {
        icon: 'satellite',
        title: 'Capteurs',
        text: 'Stations météo, sondes et pièges connectés : les relevés arrivent seuls et s’attachent à la bonne parcelle.',
      },
      {
        icon: 'barn',
        title: 'Stocks',
        text: 'Entrées, sorties et inventaires, décomptés automatiquement à chaque intervention.',
      },
      {
        icon: 'chart-donut',
        title: 'Tableaux de bord',
        text: 'Analyses par atelier, par culture ou par campagne, avec des cellules personnalisables.',
      },
      {
        icon: 'shield-check',
        title: 'Réglementation',
        text: 'Produits phytosanitaires autorisés, doses et délais vérifiés grâce aux référentiels du Lexicon.',
      },
    ]
  : [
      {
        icon: 'land-parcels',
        title: 'Fields and agronomy',
        text: 'Mapped field register, crop rotation, interventions, fertilisation and input traceability.',
      },
      {
        icon: 'cow',
        title: 'Livestock',
        text: 'Animals, groups, health events, and data exchange with the French livestock registry (EDE) through the EDNotif connector.',
      },
      {
        icon: 'grape',
        title: 'Vineyard and cellar',
        text: 'With the Ekyviti extension, from the vineyard plot all the way to the bottle.',
      },
      {
        icon: 'tractor',
        title: 'Machinery and GPS tracking',
        text: 'Machinery fleet, working hours, maintenance; GPS tracks from tractor boxes turned into interventions.',
      },
      {
        icon: 'satellite',
        title: 'Sensors',
        text: 'Weather stations, probes and connected traps: readings arrive on their own and attach to the right plot.',
      },
      {
        icon: 'barn',
        title: 'Stock',
        text: 'Receipts, issues and stocktakes, updated automatically with every intervention.',
      },
      {
        icon: 'chart-donut',
        title: 'Dashboards',
        text: 'Analysis by enterprise, crop or season, with customisable cells.',
      },
      {
        icon: 'shield-check',
        title: 'Compliance',
        text: 'Authorised plant protection products, rates and pre-harvest intervals checked against Lexicon reference data.',
      },
    ];

const tech = fr
  ? [
      'Une base PostgreSQL, avec PostGIS pour les données géographiques.',
      'Un espace de données séparé pour chaque exploitation (architecture multi-tenant).',
      'Des champs personnalisables, et des extensions (plugins) pour aller plus loin.',
      'Une API REST (version 2) documentée au format OpenAPI.',
      `Un code public sur GitHub, sous licence GNU AGPL v3 : premier commit en ${firstMonth}, ${commits} commits et ${contributors} contributeurs depuis.`,
    ]
  : [
      'A PostgreSQL database, with PostGIS for geographic data.',
      'A separate data space for each farm (multi-tenant architecture).',
      'Custom fields, and extensions (plugins) to go further.',
      'A REST API (version 2) documented in OpenAPI.',
      `Public code on GitHub under the GNU AGPL v3: first commit in ${firstMonth}, ${commits} commits and ${contributors} contributors since.`,
    ];

const audiences = fr
  ? [
      [
        'Exploitations agricoles et domaines viticoles',
        'qui veulent un seul outil pour la production, la réglementation et la gestion.',
      ],
      [
        'Coopératives, organisations agricoles et centres de gestion',
        'qui ont besoin de données consolidées et d’un outil qu’ils peuvent intégrer.',
      ],
      [
        'Fermes expérimentales, lycées agricoles et projets de recherche',
        'qui veulent un système ouvert et adaptable.',
      ],
    ]
  : [
      ['Farms and wine estates', 'that want one tool for production, compliance and management.'],
      [
        'Co-ops, farm organisations and farm accounting centres',
        'that need consolidated data and a tool they can integrate.',
      ],
      ['Research farms, agricultural colleges and research projects', 'that want an open, adaptable system.'],
    ];

const resources = [
  { href: LINKS.ekylibreOrg, label: fr ? 'Site du logiciel (ekylibre.org)' : 'Software website (ekylibre.org)' },
  { href: LINKS.demo, label: fr ? 'Démo en ligne' : 'Online demo' },
  { href: LINKS.docs, label: fr ? 'Documentation utilisateur' : 'User documentation' },
  { href: 'https://github.com/ekylibre/ekylibre', label: fr ? 'Code source sur GitHub' : 'Source code on GitHub' },
];

const jsonLd = softwareJsonLd({
  name: 'Ekylibre',
  description,
  url: LINKS.ekylibreOrg,
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
});
---

<Base lang={lang} routeKey="ekylibre" title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <ProductHero lang={lang} product="ekylibre" title={fr ? 'Toute l’exploitation, dans un seul logiciel' : 'The whole farm, in one piece of software'}>
    {fr
      ? 'Ekylibre est un logiciel libre de gestion de l’exploitation agricole (en anglais, FMIS). Matériels, stocks, suivi GPS, capteurs, agronomie, élevage et vigne partagent la même base de données : une intervention saisie au champ, ou relevée par le boîtier du tracteur, se retrouve dans les stocks, sur la carte et, avec Lyvre, dans les comptes.'
      : 'Ekylibre is free software for running a farm: a farm management information system (FMIS). Machinery, stock, GPS tracking, sensors, agronomy, livestock and vineyard share the same database, so an intervention recorded in the field, or picked up by the tractor’s box, shows up in the stock, on the map and, with Lyvre, in the books.'}
    <Fragment slot="actions">
      <a href={routePath('contact', lang)} class="btn btn-primary">
        {fr ? 'Demander une démo' : 'Request a demo'}
      </a>
      <a href={LINKS.demo} rel="noopener" target="_blank" class="btn btn-secondary">
        {fr ? 'Essayer la démo en ligne' : 'Try the online demo'}
      </a>
    </Fragment>
  </ProductHero>

  <section class="section-light py-20">
    <div class="container-site grid items-center gap-6 lg:grid-cols-[1fr_2fr_auto] lg:gap-10">
      <h2 class="text-h2">{fr ? 'Qui fait quoi' : 'Who does what'}</h2>
      <p class="text-lead text-muted">
        {fr
          ? 'Ekylibre est un commun numérique, porté avec l’association OSFarm. Ekylibre SAS l’édite et l’opère : nous développons le logiciel, publions son code, l’hébergeons pour nos clients et les accompagnons. Le code, lui, reste à tous.'
          : 'Ekylibre is a digital commons, run together with the OSFarm association. Ekylibre SAS publishes and operates it: we develop the software, release its code, host it for our customers and support them. The code itself belongs to everyone.'}
      </p>
      <Image
        src={illusBureau}
        alt=""
        widths={[240, 332]}
        sizes="(min-width: 1024px) 14rem, 60vw"
        class="mx-auto w-full max-w-[14rem] rounded-2xl"
      />
    </div>
  </section>

  <section class="section-cream py-24">
    <div class="container-site">
      <h2 class="max-w-2xl text-h2">{fr ? 'Ce que fait Ekylibre' : 'What Ekylibre does'}</h2>
      <p class="mt-4 max-w-2xl text-lead text-muted">
        {fr
          ? 'Chaque module lit et écrit dans la même base : rien n’est saisi deux fois.'
          : 'Every module reads from and writes to the same database: nothing is entered twice.'}
      </p>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {features.map((f) => (
          <li class="card">
            <span class="medallion size-12 text-xl">
              <Icon name={f.icon} />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm text-muted">{f.text}</p>
          </li>
        ))}
      </ul>
      <a
        href={routePath('lyvre', lang)}
        class="card mt-5 flex flex-col gap-5 no-underline transition hover:ring-eky-green/40 sm:flex-row sm:items-center"
      >
        <ProductLogo product={lyvre} size="md" decorative />
        <span class="grow">
          <span class="block font-display text-lg font-semibold text-night-900">
            {fr ? 'Comptabilité, ventes et achats : avec Lyvre' : 'Accounting, sales and purchasing: with Lyvre'}
          </span>
          <span class="mt-1 block text-sm text-muted">
            {fr
              ? 'Ekylibre se concentre sur la gestion de l’exploitation. Lyvre, la brique comptable de l’écosystème, reçoit ses données et tient les comptes.'
              : 'Ekylibre focuses on running the farm. Lyvre, the accounting building block of the ecosystem, receives its data and keeps the books.'}
          </span>
        </span>
        <span class="inline-flex shrink-0 items-center gap-2 font-semibold text-eky-green-text">
          {fr ? 'Découvrir Lyvre' : 'Discover Lyvre'} <Icon name="arrow-right" />
        </span>
      </a>
    </div>
  </section>

  <section class="section-light py-24">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-center">
      <Image
        src={illusRegistres}
        alt=""
        widths={[320, 500]}
        sizes="(min-width: 1024px) 26rem, 80vw"
        class="mx-auto w-full max-w-[26rem] rounded-2xl shadow-[var(--shadow-card)]"
      />
      <div>
        <h2 class="text-h2">{fr ? 'Une base solide et ouverte' : 'A solid, open foundation'}</h2>
        <ul class="mt-8 space-y-4">
          {tech.map((t) => (
            <li class="flex gap-3">
              <Icon name="check" class="mt-1.5 text-eky-green-deep" />
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <p class="mt-8">
          <a href={routePath('developers', lang)} class="font-semibold">
            {fr ? 'API, plugins et licences : la page Développeurs' : 'API, plugins and licences: the Developers page'}
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="section-dark py-24">
    <div class="container-site">
      <p class="eyebrow text-eky-green-light">{fr ? 'Connecteurs' : 'Connectors'}</p>
      <h2 class="mt-3 max-w-3xl text-h2">{fr ? 'Branché sur vos outils' : 'Plugged into your tools'}</h2>
      <p class="mt-4 max-w-3xl text-lead text-straw-50/80">
        {fr
          ? `${stats.stablePlugins} connecteurs stables relient Ekylibre aux machines, à la météo, à la banque et aux logiciels de filière.`
          : `${stats.stablePlugins} stable connectors link Ekylibre to machinery, weather, banking and sector software.`}
      </p>
      <ul class="mt-10 flex flex-wrap gap-3">
        {connectors.map((c) => (
          <li class="inline-flex items-center gap-2 rounded-full bg-night-700 px-4 py-2 text-sm ring-1 ring-white/10">
            <Icon name={CATEGORY_META[c.category].icon} class="text-eky-green-light" />
            <span class="font-display font-semibold">{c.partner?.name ?? c.title}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8">
        <a href={`${routePath('interop', lang)}#tableaux`} class="font-semibold">
          {fr ? 'Voir tous les connecteurs' : 'See all connectors'}
        </a>
      </p>
    </div>
  </section>

  <section class="section-light py-24">
    <div class="container-site">
      <div class="max-w-4xl">
        <h2 class="text-h2">
          {fr ? 'Ekyagri, Ekyviti : tout est dans Ekylibre' : 'Ekyagri, Ekyviti: it is all Ekylibre'}
        </h2>
        <p class="mt-5 text-lead text-muted">
          {fr
            ? 'Vous avez peut-être connu Ekylibre sous d’autres noms. Ekyagri était le nom de l’offre pour les exploitations agricoles ; il redevient simplement Ekylibre. Ekyviti reste le nom de l’extension dédiée à la vigne et au vin.'
            : 'You may have known Ekylibre under other names. Ekyagri was the name of the offer for farms; it is simply Ekylibre again. Ekyviti remains the name of the extension for vineyards and wine.'}
        </p>
      </div>
    </div>
  </section>

  <section class="section-cream py-24">
    <div class="container-site grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div>
        <h2 class="text-h2">{fr ? 'Pour qui' : 'Who it is for'}</h2>
        <ul class="mt-8 space-y-5">
          {audiences.map(([who, why]) => (
            <li class="border-t border-soil-800/10 pt-5">
              <strong class="font-display">{who}</strong> {why}
            </li>
          ))}
        </ul>

        <h2 class="mt-20 text-h2">{fr ? 'Comment utiliser Ekylibre' : 'How to use Ekylibre'}</h2>
        <p class="mt-4 text-lead text-muted">
          {fr
            ? 'Il n’y a pas d’abonnement à souscrire en ligne. Deux possibilités :'
            : 'There is no online subscription to sign up for. You have two options:'}
        </p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <div class="card">
            <h3 class="font-display text-lg font-semibold">{fr ? 'Avec Ekylibre SAS' : 'With Ekylibre SAS'}</h3>
            <p class="mt-2 text-sm text-muted">
              {fr
                ? 'Nous mettons en place votre instance, reprenons vos données, formons vos équipes et assurons le support.'
                : 'We set up your instance, migrate your data, train your teams and provide support.'}
            </p>
            <a href={routePath('services', lang)} class="mt-4 inline-block text-sm font-semibold">
              {fr ? 'Nos services' : 'Our services'}
            </a>
          </div>
          <div class="card">
            <h3 class="font-display text-lg font-semibold">{fr ? 'Par vos propres moyens' : 'On your own'}</h3>
            <p class="mt-2 text-sm text-muted">
              {fr
                ? 'Le code est libre : vous pouvez l’installer sur vos serveurs en suivant la documentation technique.'
                : 'The code is free software: you can install it on your own servers by following the technical documentation.'}
            </p>
            <a href={LINKS.techdoc} rel="noopener" target="_blank" class="mt-4 inline-block text-sm font-semibold">
              {fr ? 'Documentation technique' : 'Technical documentation'}
            </a>
          </div>
        </div>
      </div>
      <aside class="lg:pt-2">
        <Image
          src={illusPlan}
          alt=""
          widths={[320, 500]}
          sizes="(min-width: 1024px) 24rem, 80vw"
          class="mx-auto w-full max-w-[24rem] rounded-2xl shadow-[var(--shadow-card)]"
        />
        <h3 class="mt-10 font-display text-lg font-semibold">{fr ? 'Liens utiles' : 'Useful links'}</h3>
        <ul class="mt-4 space-y-3">
          {resources.map((r) => (
            <li>
              <a href={r.href} rel="noopener" target="_blank" class="inline-flex items-center gap-2">
                <Icon name="link" /> {r.label}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <ProductCta
    lang={lang}
    title={fr ? 'Voyez Ekylibre avec vos propres données' : 'See Ekylibre with your own data'}
    text={
      fr
        ? 'En une démonstration, nous partons de votre exploitation et de vos outils pour vous montrer ce qu’Ekylibre peut relier.'
        : 'In one demo, we start from your farm and your tools and show you what Ekylibre can connect.'
    }
    site={{ href: LINKS.ekylibreOrg, label: fr ? 'Découvrir ekylibre.org' : 'Visit ekylibre.org' }}
  />
</Base>
