---
// C8 — Fiche de détail d'un élément de la scène (zone de la ferme ou famille du Lexicon).
// Panneau non modal : focus déplacé à l'ouverture, Échap ou bouton pour fermer, focus restitué.
// Les données viennent du JSON de l'îlot <farm-scene> (aucune requête supplémentaire).
import Icon from './Icon.astro';
import { routePath, type Locale } from '~/i18n/routes';
import { LINKS } from '~/lib/links';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const strings = {
  fr: {
    close: 'Fermer la fiche',
    in: 'Vers Fourmy',
    out: 'Depuis Fourmy',
    both: 'Dans les deux sens',
    version: 'Version',
    source: 'Code source',
    partner: 'Partenaire',
    datasets: 'jeux de données',
    rows: 'lignes',
    members: 'Adhérents OSFarm',
    catalog: 'Explorer le catalogue du Lexicon',
    hubText:
      'Fourmy réunit les données de toute l’exploitation : chaque connecteur y dépose ses informations, une seule fois, dans un modèle commun.',
    hubLink: 'Découvrir Fourmy',
    interop: 'Voir tous les connecteurs',
    empty: 'Connecteurs en préparation pour cette zone.',
    page: 'Découvrir',
  },
  en: {
    close: 'Close',
    in: 'Into Fourmy',
    out: 'From Fourmy',
    both: 'Both ways',
    version: 'Version',
    source: 'Source code',
    partner: 'Partner',
    datasets: 'datasets',
    rows: 'records',
    members: 'OSFarm members',
    catalog: 'Explore the Lexicon catalogue',
    hubText:
      'Fourmy brings together data from the whole farm: every connector delivers its information once, into a shared model.',
    hubLink: 'Discover Fourmy',
    interop: 'See all connectors',
    empty: 'Connectors for this area are on their way.',
    page: 'Discover',
  },
}[lang];
const links = {
  fourmy: routePath('fourmy', lang),
  interop: routePath('interop', lang),
  catalog: LINKS.lexiconCatalog,
};
---

<aside
  id="scene-info"
  class="scene-info section-dark fixed inset-x-3 bottom-3 z-40 max-h-[70dvh] overflow-y-auto rounded-2xl p-6 shadow-2xl ring-1 ring-white/12 sm:inset-x-auto sm:top-24 sm:right-6 sm:bottom-auto sm:w-[25rem]"
  role="dialog"
  aria-modal="false"
  aria-labelledby="scene-info-title"
  data-lang={lang}
  data-strings={JSON.stringify(strings)}
  data-links={JSON.stringify(links)}
  hidden
>
  <button
    type="button"
    class="scene-info__close absolute top-3 right-3 grid size-10 place-items-center rounded-full text-straw-50/70 hover:bg-white/8 hover:text-straw-50"
    aria-label={strings.close}
  >
    <Icon name="times" class="text-lg" />
  </button>
  <div class="scene-info__body"></div>
</aside>

<script>
  import type { FarmSceneProps, SelectDetail } from '~/islands/farm-scene/types';

  const card = document.getElementById('scene-info');
  const scene = document.querySelector<HTMLElement>('farm-scene');
  if (card && scene) {
    const body = card.querySelector<HTMLElement>('.scene-info__body')!;
    const strings = JSON.parse(card.dataset.strings ?? '{}') as Record<string, string>;
    const links = JSON.parse(card.dataset.links ?? '{}') as Record<string, string>;
    const lang = card.dataset.lang ?? 'fr';
    const nf = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB');
    const compact = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-US', { notation: 'compact' });
    let origin: HTMLElement | undefined;

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
    const icon = (sprite: string, name: string) =>
      `<svg class="icon" aria-hidden="true"><use href="${sprite}#i-${name}"></use></svg>`;
    const external = (href: string, label: string) =>
      `<a href="${esc(href)}" rel="noopener" target="_blank">${esc(label)}</a>`;

    const close = () => {
      card.hidden = true;
      origin?.setAttribute('aria-expanded', 'false');
      origin?.focus({ preventScroll: true });
      origin = undefined;
    };

    const render = (detail: SelectDetail) => {
      const props = JSON.parse(scene.dataset.props ?? '{}') as FarmSceneProps;
      const sprite = props.iconSprite;
      if (detail.kind === 'zone') {
        const zone = props.zones[detail.id];
        const list = props.connectors.filter((c) => c.zone === detail.id);
        const isHub = detail.id === 'hub';
        const items = list
          .map(
            (c) => `
          <li class="border-t border-white/10 pt-4">
            <p class="flex items-center gap-2 font-display font-semibold">${
              c.logo
                ? `<img src="${esc(c.logo)}" alt="" width="28" height="28" class="size-7 rounded-md bg-straw-50 p-0.5" />`
                : icon(sprite, c.icon)
            } ${esc(c.title)}</p>
            ${c.statusLabel ? `<p class="mt-2 font-mono text-xs tracking-wider text-wheat-400 uppercase">${esc(c.statusLabel)}</p>` : ''}
            <p class="mt-1.5 text-sm text-straw-50/80">${esc(c.summary)}</p>
            <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-straw-50/60">
              <span class="text-eky-green-light">${esc(strings[c.dataFlow] ?? '')}</span>
              ${c.partner ? `<span>${esc(strings.partner!)} : ${c.partnerUrl ? external(c.partnerUrl, c.partner) : esc(c.partner)}</span>` : ''}
              ${c.version ? `<span>${esc(strings.version!)} ${esc(c.version)}</span>` : ''}
              ${external(c.repoUrl, strings.source!)}
              ${c.pageUrl ? `<a href="${esc(c.pageUrl)}">${esc(strings.page!)} ${esc(c.title)}</a>` : ''}
            </p>
          </li>`,
          )
          .join('');
        body.innerHTML = `
          <p class="eyebrow text-eky-green-light">${icon(sprite, zone?.icon ?? 'farm')} La Vauzelle</p>
          <h2 id="scene-info-title" tabindex="-1" class="mt-2 pr-10 text-h3">${esc(isHub ? 'Ekylibre' : (zone?.title ?? ''))}</h2>
          ${isHub ? `<p class="mt-3 text-straw-50/85">${esc(strings.hubText!)}</p>` : ''}
          ${items ? `<ul class="mt-4 space-y-4">${items}</ul>` : isHub ? '' : `<p class="mt-3 text-straw-50/70">${esc(strings.empty!)}</p>`}
          <p class="mt-6 flex flex-wrap gap-4 text-sm font-semibold">
            ${isHub ? `<a href="${links.fourmy}">${esc(strings.hubLink!)}</a>` : ''}
            <a href="${links.interop}">${esc(strings.interop!)}</a>
          </p>`;
      } else {
        const family = props.families.find((f) => f.id === detail.id);
        if (!family) return;
        const rows = family.datasets
          .map(
            (d) => `
          <li class="flex items-baseline justify-between gap-3 border-t border-white/10 py-2 text-sm">
            <span><a href="${esc(d.href)}" rel="noopener" target="_blank">${esc(d.label)}</a>
              <span class="block font-mono text-xs text-straw-50/55">${esc(d.provider)}${d.scope === 'members' ? ` · ${esc(strings.members!)}` : ''}</span></span>
            <span class="shrink-0 font-mono text-xs text-straw-50/70 tabular-nums">${compact.format(d.rows)}</span>
          </li>`,
          )
          .join('');
        body.innerHTML = `
          <p class="eyebrow fam-text fam-${esc(family.id)}">${icon(sprite, family.icon)} Lexicon</p>
          <h2 id="scene-info-title" tabindex="-1" class="mt-2 pr-10 text-h3">${esc(family.title)}</h2>
          <p class="mt-2 font-mono text-sm text-straw-50/70">${family.datasets.length} ${esc(strings.datasets!)} · ${nf.format(family.rows)} ${esc(strings.rows!)}</p>
          <ul class="mt-4">${rows}</ul>
          <p class="mt-5 text-sm font-semibold">${external(links.catalog!, strings.catalog!)}</p>`;
      }
      card.hidden = false;
      card.querySelector<HTMLElement>('#scene-info-title')?.focus({ preventScroll: true });
    };

    document.addEventListener('eky:select', (e) => {
      origin?.setAttribute('aria-expanded', 'false');
      origin = e.detail.origin;
      origin?.setAttribute('aria-expanded', 'true');
      render(e.detail);
    });
    card.querySelector('.scene-info__close')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !card.hidden) close();
    });
  }
</script>
