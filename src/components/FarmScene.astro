---
// Îlot 3D « La ferme connectée ». Le HTML ne contient qu'un conteneur vide : l'image d'attente
// (photo ou rendu) est fournie par la page, en dessous. three.js n'est chargé que lorsque la
// scène devient visible et que le navigateur est disponible, puis la scène apparaît en fondu.
// La fiche de détail (InfoCard) est un frère du conteneur, pour échapper à son contexte d'empilement.
import { routePath, withBase } from '~/i18n/routes';
import { getProduct, STATUS_LABEL } from '~/lib/products';
import {
  connectors as allConnectors,
  lexiconFamilies,
  CATEGORY_META,
  CONNECTOR_STATUS_LABEL,
  ZONE_META,
  FAMILY_COLORS,
} from '~/lib/interop';
import type { FarmSceneProps, SceneConnector } from '~/islands/farm-scene/types';
import InfoCard from './InfoCard.astro';

interface Props {
  mode?: FarmSceneProps['mode'];
  lang: FarmSceneProps['lang'];
  view?: string;
  focusX?: number;
  chapters?: FarmSceneProps['chapters'];
  class?: string;
}
const { mode = 'hero', lang, view = 'site', focusX, chapters, class: className } = Astro.props;

// Scène : intégrations de Fourmy seulement ; celles de Lyvre sont dans le tableau (D34).
const connectors: SceneConnector[] = (await allConnectors(lang, { product: 'fourmy' })).map((c) => ({
  slug: c.slug,
  category: c.category,
  icon: CATEGORY_META[c.category].icon,
  zone: c.zone ?? 'hub',
  dataFlow: c.dataFlow,
  title: c.title,
  summary: c.summary,
  partner: c.partner?.name,
  partnerUrl: c.partner?.url,
  version: '',
  repoUrl: c.hasCode ? c.codeUrl : '',
  statusLabel: c.status === 'en-cours' ? CONNECTOR_STATUS_LABEL[c.status][lang] : undefined,
}));
// Aiffel et Lyvre ne sont pas des plugins d'Ekylibre : Aiffel dialogue avec l'agriculteur dans la cour,
// Lyvre tient la comptabilité au bureau (docs/design/03-outils-lyvre.md §8). Logos officiels, état réel.
const aiffel = getProduct('aiffel', lang);
const lyvre = getProduct('lyvre', lang);
const fr = lang === 'fr';
const ecosystem: SceneConnector[] = [];
ecosystem.push({
  slug: 'aiffel',
  category: 'gestion',
  icon: 'microphone',
  zone: 'cour',
  dataFlow: 'in',
  title: 'Aiffel',
  summary:
    lang === 'fr'
      ? 'L’assistant à qui l’on parle, à la voix ou par écrit : il prépare, vérifie dans le Lexicon et écrit dans Fourmy après validation.'
      : 'The assistant you talk to, by voice or text: it prepares, checks against Lexicon and writes to Fourmy once approved.',
  partner: 'aiffel.org',
  partnerUrl: 'https://aiffel.org/',
  version: '',
  repoUrl: aiffel.links.code ?? 'https://github.com/ekylibre/aiffel',
  logo: aiffel.logo.src,
  statusLabel: STATUS_LABEL[aiffel.status][lang],
  pageUrl: routePath('aiffel', lang),
});
ecosystem.push({
  slug: 'lyvre',
  category: 'finance',
  icon: 'book-open',
  zone: 'bureau',
  dataFlow: 'out',
  title: 'Lyvre',
  summary: fr
    ? 'La brique comptable de l’écosystème : Lyvre recevra les achats, ventes et stocks valorisés de Fourmy, et les pièces dictées à Aiffel, pour en tirer la comptabilité.'
    : 'The accounting building block of the ecosystem: Lyvre will receive purchases, sales and stock valuation from Fourmy, and documents dictated to Aiffel, and turn them into accounts.',
  partner: undefined,
  partnerUrl: undefined,
  version: '',
  repoUrl: lyvre.links.code ?? lyvre.links.site,
  logo: lyvre.logo.src,
  statusLabel: `${STATUS_LABEL[lyvre.status][lang]} · ${lyvre.subStatus ?? ''}`,
  pageUrl: routePath('lyvre', lang),
  wipLinks: ['hub', 'cour'],
});
connectors.push(...ecosystem);
const families = (await lexiconFamilies(lang)).map((f) => ({ ...f, color: FAMILY_COLORS[f.id] ?? '#4ed164' }));
const zones = Object.fromEntries(
  Object.entries(ZONE_META).map(([id, z]) => [id, { title: z.title[lang], icon: z.icon }]),
);
// Moyeu : « Le système d'information agricole », logo et nom de Fourmy (docs/design/04 §3.2).
const fourmy = getProduct('fourmy', lang);
const strings = {
  fr: {
    'hub.title': 'Le système d’information agricole',
    'hub.subtitle': 'Fourmy',
    'family.datasets': 'jeux de données',
    'family.dataset': 'jeu de données',
  },
  en: {
    'hub.title': 'The farm information system',
    'hub.subtitle': 'Fourmy',
    'family.datasets': 'datasets',
    'family.dataset': 'dataset',
  },
}[lang];

const props: FarmSceneProps = {
  mode,
  lang,
  view,
  manifestUrl: withBase('/3d/scene.json'),
  modelUrl: withBase(mode === 'hero' ? '/3d/hero.glb' : '/3d/farm-full.glb'),
  iconSprite: withBase('/icons/agric.svg'),
  connectors,
  families,
  zones,
  strings,
  hubLogo: fourmy.logo.src,
  ...(focusX === undefined ? {} : { focusX }),
  ...(chapters ? { chapters } : {}),
};
---

<farm-scene
  class:list={['farm-scene block', className]}
  data-props={JSON.stringify(props)}
  data-state="idle"
></farm-scene>
<InfoCard lang={lang} />

<style>
  .farm-scene {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out-soft);
  }
  .farm-scene[data-state='ready'] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .farm-scene {
      transition: none;
    }
  }
</style>

<script>
  import { detectTier } from '~/islands/farm-scene/quality';
  import type { FarmSceneProps } from '~/islands/farm-scene/types';

  const FIRST_FRAME_TIMEOUT = 8000;

  class FarmSceneElement extends HTMLElement {
    private started = false;

    connectedCallback() {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting) || this.started) return;
          this.started = true;
          io.disconnect();
          const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
          idle(() => void this.start(), { timeout: 1500 });
        },
        { rootMargin: '200px' },
      );
      io.observe(this);
    }

    private fallback(reason: string) {
      this.dataset.state = 'fallback';
      document.dispatchEvent(new CustomEvent('eky:fallback', { detail: { reason } }));
    }

    private async start() {
      const props = JSON.parse(this.dataset.props ?? '{}') as FarmSceneProps;
      // En développement : ?view=<nom> force une vue fixe (cadrage des vues et des zones).
      if (import.meta.env.DEV) {
        const forced = new URLSearchParams(location.search).get('view');
        if (forced) Object.assign(props, { view: forced, still: true, focusX: 0.5 });
      }
      const report = detectTier();
      this.dataset.tier = report.tier;
      if (report.tier === 'none') return this.fallback(report.reason);
      this.dataset.state = 'loading';
      let timedOut = false;
      const timer = setTimeout(() => {
        timedOut = true;
        this.fallback('timeout');
      }, FIRST_FRAME_TIMEOUT);
      try {
        const { mountFarmScene } = await import('~/islands/farm-scene/main');
        const handle = await mountFarmScene(this, props, report);
        clearTimeout(timer);
        if (timedOut) return handle.dispose();
        this.dataset.state = 'ready';
        document.dispatchEvent(new CustomEvent('eky:ready', { detail: { tier: report.tier } }));
      } catch (error) {
        clearTimeout(timer);
        console.warn('[farm-scene]', error);
        if (!timedOut) this.fallback(error instanceof Error ? error.message : 'error');
      }
    }
  }

  if (!customElements.get('farm-scene')) customElements.define('farm-scene', FarmSceneElement);
</script>
