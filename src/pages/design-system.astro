---
// Référence visuelle du design system (non indexée, hors sitemap). docs/design/02-architecture.md §7.
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { ICON_NAMES } from '~/lib/icon-names';

const swatches = [
  ['eky-green', '#00C15D', 'bg-eky-green'],
  ['eky-green-light', '#4ED164', 'bg-eky-green-light'],
  ['eky-green-deep', '#008F46', 'bg-eky-green-deep'],
  ['eky-green-text', '#00703A', 'bg-eky-green-text'],
  ['night-900', '#07140E', 'bg-night-900'],
  ['night-700', '#0F2A1E', 'bg-night-700'],
  ['straw-50', '#FAF6EC', 'bg-straw-50'],
  ['straw-100', '#F3EBD8', 'bg-straw-100'],
  ['cream-200', '#EBE4B8', 'bg-cream-200'],
  ['wheat-400', '#E2B76C', 'bg-wheat-400'],
  ['ochre-400', '#CE9558', 'bg-ochre-400'],
  ['clay-500', '#C46A3C', 'bg-clay-500'],
  ['grass-500', '#8DB44F', 'bg-grass-500'],
  ['sky-300', '#8EC5E8', 'bg-sky-300'],
  ['soil-800', '#3A2C20', 'bg-soil-800'],
  ['ink-500', '#5B6B63', 'bg-ink-500'],
  ['mint-100', '#C3E0C6', 'bg-mint-100'],
  ['apricot-100', '#FCD79E', 'bg-apricot-100'],
];
const families = ['territoire', 'climat', 'intrants', 'entreprises', 'marches', 'savoirs', 'filiere'];
---

<Base lang="fr" routeKey="home" title="Design system" noindex>
  <section class="section-light py-16">
    <div class="container-site space-y-16">
      <header>
        <p class="eyebrow text-eky-green-text">Référence interne</p>
        <h1 class="mt-3 text-h1">Design system « l’heure dorée numérique »</h1>
      </header>

      <div>
        <h2 class="text-h3">Couleurs</h2>
        <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
          {swatches.map(([name, hex, cls]) => (
            <li class="card p-3">
              <span class:list={['block h-16 rounded-lg ring-1 ring-black/10', cls]} />
              <span class="mt-2 block font-mono text-xs">{name}</span>
              <span class="block font-mono text-xs text-muted">{hex}</span>
            </li>
          ))}
        </ul>
        <ul class="mt-6 flex flex-wrap gap-3">
          {families.map((f) => (
            <li class="flex items-center gap-2 font-mono text-xs">
              <span class="size-4 rounded-full" style={`background: var(--color-family-${f})`} />
              {f}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-h3">Typographie</h2>
        <p class="mt-6 font-display text-display font-bold">Montserrat display</p>
        <p class="font-display text-h1 font-bold">Titre H1 — Montserrat 700</p>
        <p class="font-display text-h2 font-bold">Titre H2 — Montserrat 700</p>
        <p class="font-display text-h3 font-semibold">Titre H3 — Montserrat 600</p>
        <p class="mt-4 max-w-2xl text-lead">
          Texte d’introduction en Inter : relier les machines, les capteurs, la comptabilité et les données publiques.
        </p>
        <p class="mt-2 max-w-2xl">
          Texte courant en Inter. <a href="#">Lien dans le texte</a>. Les chiffres et le code sont en
          <code>JetBrains Mono : 623 191 518</code>.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a class="btn btn-primary" href="#">
          Bouton principal
        </a>
        <a class="btn btn-secondary" href="#">
          Bouton secondaire
        </a>
      </div>
    </div>
  </section>

  <section class="section-dark py-16">
    <div class="container-site space-y-12">
      <div class="flex flex-wrap items-center gap-4">
        <a class="btn btn-primary" href="#">
          Bouton principal
        </a>
        <a class="btn btn-secondary" href="#">
          Bouton secondaire
        </a>
        <a href="#">Lien sur fond sombre</a>
      </div>
      <div>
        <h2 class="text-h3">Médaillons</h2>
        <div class="mt-6 flex flex-wrap gap-6">
          {['tractor', 'cloudy', 'cow', 'grape', 'hand-holding-dollar', 'database'].map((n) => (
            <span class="medallion size-20 text-4xl">
              <Icon name={n as (typeof ICON_NAMES)[number]} />
            </span>
          ))}
        </div>
      </div>
      <div>
        <h2 class="text-h3">Pictogrammes agric ({ICON_NAMES.length})</h2>
        <ul class="mt-6 grid grid-cols-4 gap-3 sm:grid-cols-8 lg:grid-cols-12">
          {ICON_NAMES.map((n) => (
            <li class="flex flex-col items-center gap-2 rounded-lg p-2 text-center ring-1 ring-white/8">
              <Icon name={n} class="text-2xl text-eky-green-light" />
              <span class="font-mono text-[0.6rem] break-all text-straw-50/60">{n}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-light py-16">
    <div class="container-site">
      <h2 class="text-h3">Médaillons (registre clair)</h2>
      <div class="mt-6 flex flex-wrap gap-6">
        {['wheat', 'barn', 'truck', 'store'].map((n) => (
          <span class="medallion size-20 text-4xl">
            <Icon name={n as (typeof ICON_NAMES)[number]} />
          </span>
        ))}
      </div>
    </div>
  </section>
</Base>
