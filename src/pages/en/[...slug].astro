---
import Placeholder from '~/components/Placeholder.astro';
import { placeholderPaths } from '~/lib/placeholders';
import type { RouteKey } from '~/i18n/routes';

export function getStaticPaths() {
  return placeholderPaths('en');
}
const { routeKey } = Astro.props as { routeKey: RouteKey };
---

<Placeholder lang="en" routeKey={routeKey} />
