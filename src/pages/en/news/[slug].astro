---
import NewsArticle from '~/components/news/NewsArticle.astro';
import { getNews, newsSlug, type NewsEntry } from '~/lib/news';

export async function getStaticPaths() {
  return (await getNews('en')).map((entry) => ({ params: { slug: newsSlug(entry) }, props: { entry } }));
}
const { entry } = Astro.props as { entry: NewsEntry };
---

<NewsArticle entry={entry} />
