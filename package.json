{
  "name": "ekylibre-sas",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Site ekylibre.com — Ekylibre SAS",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch:data": "node scripts/fetch-plugins.mjs && node scripts/fetch-lexicon.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dev": "astro dev",
    "build": "node scripts/check-content.mjs && astro check && astro build && node scripts/check-content.mjs --links",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-content.mjs --links",
    "prepare:3d": "node scripts/prepare-3d.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.187.0",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3"
  }
}
